{
  "manifest_version": 3,
  "name": "Figurinha com Som",
  "version": "1.0.0",
  "description": "Cria figurinha animada com som a partir de um vídeo e envia pelo WhatsApp Web. Tudo é feito no seu computador.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_title": "Figurinha com Som",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png"
    }
  },
  "background": { "service_worker": "src/fundo.js" },
  "permissions": ["scripting"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/ponte.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/nucleo.js", "src/estilo.js", "src/painel.js"],
      "run_at": "document_idle"
    }
  ]
}
